# Talaria — Plymouth boot splash
# Three-feather mark streaks in, wordmark settles, orange progress track.
# Authored against a 1920x1080 reference; every value scales by screen height.

#--- background -------------------------------------------------------------
Window.SetBackgroundTopColor(0.231, 0.082, 0.502);      # #3B1580 — purple crown
Window.SetBackgroundBottomColor(0.027, 0.012, 0.059);   # #07030F — near-black base

screen.width  = Window.GetWidth(0);
screen.height = Window.GetHeight(0);
screen.x      = Window.GetX(0);
screen.y      = Window.GetY(0);
scale         = screen.height / 1080;

REFRESH_RATE = 50;   # Plymouth drives the refresh function ~50x/second

#--- helpers ----------------------------------------------------------------
fun clamp(v, lo, hi) {
  if (v < lo) return lo;
  if (v > hi) return hi;
  return v;
}

# cubic ease-out, the motion curve the whole splash uses
fun ease(x) {
  x = clamp(x, 0, 1);
  u = 1 - x;
  return 1 - u * u * u;
}

# progress of a timed segment [a,b] at time t
fun seg(t, a, b) {
  return ease((t - a) / (b - a));
}

fun place(sprite, image, cx, cy, z) {
  sprite.SetImage(image);
  sprite.SetPosition(cx - image.GetWidth() / 2, cy - image.GetHeight() / 2, z);
  sprite.SetOpacity(0);
}

#--- geometry ---------------------------------------------------------------
mark.size   = 400 * scale;
mark.cx     = screen.x + screen.width / 2;
mark.cy     = screen.y + screen.height * 0.40;
word.cy     = mark.cy + mark.size * 0.52;
bar.width   = 520 * scale;
bar.height  = 8 * scale;
bar.x       = mark.cx - bar.width / 2;
bar.y       = screen.y + screen.height - 132 * scale;

#--- sprites ----------------------------------------------------------------
# feathers share one origin, so each only needs an x offset to fly in
for (i = 1; i <= 3; i++) {
  feather[i].image  = Image("assets/feather-" + i + ".png").Scale(mark.size, mark.size);
  feather[i].sprite = Sprite();
  place(feather[i].sprite, feather[i].image, mark.cx, mark.cy, 10);
}
feather[1].from = -560 * scale;   # stagger: long feather leads
feather[2].from = -430 * scale;
feather[3].from = -320 * scale;
feather[1].at   = 0.10;
feather[2].at   = 0.24;
feather[3].at   = 0.38;

word.image  = Image("assets/wordmark.png");
word.image  = word.image.Scale(word.image.GetWidth() * scale, word.image.GetHeight() * scale);
word.sprite = Sprite();
place(word.sprite, word.image, mark.cx, word.cy, 10);

track.sprite = Sprite(Image("assets/bar-track.png").Scale(bar.width, bar.height));
track.sprite.SetPosition(bar.x, bar.y, 8);
track.sprite.SetOpacity(0);

fill.sprite = Sprite();
fill.image  = Image("assets/bar-fill.png");
fill.sprite.SetPosition(bar.x, bar.y, 9);
fill.sprite.SetOpacity(0);

#--- state ------------------------------------------------------------------
frame        = 0;
progress     = 0;      # reported by systemd, 0..1
has_progress = 0;      # until the first report, sweep indeterminately
quitting     = 0;
quit_at      = 0;
message.sprite = Sprite();
message.sprite.SetOpacity(0);

fun draw_fill(fraction, opacity) {
  w = clamp(fraction, 0.001, 1) * bar.width;
  fill.sprite.SetImage(fill.image.Scale(w, bar.height));
  fill.sprite.SetPosition(bar.x, bar.y, 9);
  fill.sprite.SetOpacity(opacity);
}

# fractional part, without relying on Math.Int being present
fun fract(v) {
  while (v >= 1) v = v - 1;
  while (v < 0)  v = v + 1;
  return v;
}

fun draw_sweep(t, opacity) {
  w   = 0.34;
  cyc = fract((t - 1.5) / 1.9);
  x   = (1 + w) * ease(cyc) - w;
  x   = clamp(x, 0, 1 - w) * bar.width;
  fill.sprite.SetImage(fill.image.Scale(w * bar.width, bar.height));
  fill.sprite.SetPosition(bar.x + x, bar.y, 9);
  fill.sprite.SetOpacity(opacity);
}

#--- per-frame --------------------------------------------------------------
fun refresh() {
  frame++;
  t = frame / REFRESH_RATE;

  fade_out = 1;
  if (quitting) {
    fade_out = 1 - ease((t - quit_at) / 0.55);
    lift = 1 + 0.05 * (1 - fade_out);
  }

  # feathers fly in
  for (i = 1; i <= 3; i++) {
    p = seg(t, feather[i].at, feather[i].at + 0.62);
    feather[i].sprite.SetOpacity(clamp(p * 1.6, 0, 1) * fade_out);
    feather[i].sprite.SetX(mark.cx - mark.size / 2 + feather[i].from * (1 - p));
  }

  # wordmark rises into place
  wp = seg(t, 0.82, 1.5);
  word.sprite.SetOpacity(wp * fade_out);
  word.sprite.SetY(word.cy - word.image.GetHeight() / 2 + 18 * scale * (1 - wp));

  # progress chrome
  chrome = seg(t, 1.25, 1.9) * fade_out;
  track.sprite.SetOpacity(chrome * 0.9);
  message.sprite.SetOpacity(chrome);

  if (has_progress) {
    draw_fill(progress, chrome);
  } else {
    draw_sweep(t, chrome);
  }
}
Plymouth.SetRefreshFunction(refresh);

#--- plymouth callbacks -----------------------------------------------------
fun on_boot_progress(duration, fraction) {
  has_progress = 1;
  if (fraction > progress) progress = fraction;   # never runs backwards
}
Plymouth.SetBootProgressFunction(on_boot_progress);

fun on_message(text) {
  message.image  = Image.Text(text, 0.654, 0.545, 0.980);   # #A78BFA
  message.sprite.SetImage(message.image);
  message.sprite.SetPosition(mark.cx - message.image.GetWidth() / 2,
                             bar.y + 34 * scale, 10);
}
Plymouth.SetMessageFunction(on_message);

fun on_quit() {
  quitting = 1;
  quit_at  = frame / REFRESH_RATE;
}
Plymouth.SetQuitFunction(on_quit);

# Appliance builds normally boot unattended. If the signage image ever ships
# with an encrypted data partition, wire the password callbacks here.
fun on_display_password(prompt, bullets) {
  on_message(prompt);
}
Plymouth.SetDisplayPasswordFunction(on_display_password);

fun on_display_normal() {
  message.sprite.SetOpacity(0);
}
Plymouth.SetDisplayNormalFunction(on_display_normal);
