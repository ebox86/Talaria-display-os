#!/bin/sh
#
# Manual bring-up helper: point the Cog supervisor at a data: HTML URL
# so graphics/browser rendering can be tested without DNS, internet,
# a Talaria server, or local file MIME handling.

run_dir="${TALARIA_BROWSER_RUN_DIR:-/run/talaria}"
state_file="${TALARIA_MODE_STATE:-$run_dir/mode-state.conf}"
test_url="${TALARIA_BROWSER_TEST_URL:-data:text/html;base64,}"

/etc/init.d/S70talaria-mode-resolve stop 2>/dev/null || true

mkdir -p "$run_dir"
{
  echo "EFFECTIVE_MODE=dashboard"
  echo "DISPLAY_URL='$test_url'"
  echo 'FALLBACK_REASON=""'
  echo "DEVICE_ID=browser-test"
  echo "RESOLVED_AT=\"$(date)\""
} > "$state_file"

/etc/init.d/S80talaria-browser restart
echo "Started Talaria browser test"
