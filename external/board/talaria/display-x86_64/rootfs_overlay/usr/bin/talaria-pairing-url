#!/bin/sh

pairing_code_file="${TALARIA_PAIRING_CODE_FILE:-/data/talaria/pairing-code}"
pairing_nonce_file="${TALARIA_PAIRING_NONCE_FILE:-${pairing_code_file}.nonce}"
screen_source_dir="${TALARIA_PAIRING_SCREEN_SOURCE_DIR:-/usr/share/talaria/screens}"
screen_run_dir="${TALARIA_PAIRING_SCREEN_DIR:-/run/talaria/screens}"
device_id="${TALARIA_DEVICE_ID:-unconfigured}"
server_base_url="${TALARIA_SERVER_BASE_URL:-}"
assignment_url="${TALARIA_ASSIGNMENT_URL:-}"
assignment_status="${TALARIA_ASSIGNMENT_FETCH_STATUS:-disabled}"
refresh_seconds="${TALARIA_ASSIGNMENT_REFRESH_SECONDS:-15}"
script_dir="$(CDPATH= cd -- "$(dirname -- "$0")" 2>/dev/null && pwd)"

if [ ! -r "$screen_source_dir/pairing.html" ] && [ -n "$script_dir" ]; then
  host_overlay_source="${script_dir%/usr/bin}/usr/share/talaria/screens"
  if [ -r "$host_overlay_source/pairing.html" ]; then
    screen_source_dir="$host_overlay_source"
  fi
fi

json_escape() {
  printf '%s' "$1" | tr '\r\n' '  ' | sed 's/\\/\\\\/g; s/"/\\"/g; s/	/\\t/g'
}

query_escape() {
  printf '%s' "$1" | sed \
    -e 's/%/%25/g' \
    -e 's/ /%20/g' \
    -e 's/:/%3A/g' \
    -e 's/\//%2F/g' \
    -e 's/?/%3F/g' \
    -e 's/&/%26/g' \
    -e 's/=/%3D/g' \
    -e 's/#/%23/g' \
    -e 's/+/%2B/g' \
    -e 's/"/%22/g' \
    -e "s/'/%27/g"
}

make_pairing_code() {
  local code raw seed code_dir

  if [ -n "${TALARIA_PAIRING_CODE:-}" ]; then
    printf '%s\n' "$TALARIA_PAIRING_CODE"
    return 0
  fi

  if [ -r "$pairing_code_file" ]; then
    code="$(head -n 1 "$pairing_code_file" 2>/dev/null || true)"
    case "$code" in
      [A-Z0-9][A-Z0-9][A-Z0-9][A-Z0-9]-[A-Z0-9][A-Z0-9][A-Z0-9][A-Z0-9])
        printf '%s\n' "$code"
        return 0
        ;;
    esac
  fi

  code_dir="${pairing_code_file%/*}"
  [ "$code_dir" = "$pairing_code_file" ] || mkdir -p "$code_dir" 2>/dev/null || true

  raw="$(od -An -N4 -tu4 /dev/urandom 2>/dev/null | tr -d ' ' || true)"
  if [ -n "$raw" ]; then
    code="$(awk -v n="$raw" 'BEGIN { printf "%08d", n % 100000000 }')"
    code="${code%????}-${code#????}"
    if [ ! -d "$pairing_code_file" ] && { printf '%s\n' "$code" > "$pairing_code_file"; } 2>/dev/null; then
      printf '%s\n' "$code"
      return 0
    fi
  fi

  # If /data is unavailable, keep the code stable for this boot so the
  # resolver does not hand the browser a different URL every cycle.
  seed="$device_id $(cat /proc/sys/kernel/random/boot_id 2>/dev/null) $(cat /sys/class/net/*/address 2>/dev/null)"
  raw="$(printf '%s' "$seed" | cksum | awk '{print $1}')"
  code="$(awk -v n="$raw" 'BEGIN { printf "%08d", n % 100000000 }')"
  code="${code%????}-${code#????}"

  if [ ! -d "$pairing_code_file" ]; then
    { printf '%s\n' "$code" > "$pairing_code_file"; } 2>/dev/null || true
  fi
  printf '%s\n' "$code"
}

make_nonce() {
  local nonce raw nonce_dir seed

  if [ -n "${TALARIA_PAIRING_NONCE:-}" ]; then
    printf '%s\n' "$TALARIA_PAIRING_NONCE"
    return 0
  fi

  if [ -r "$pairing_nonce_file" ]; then
    nonce="$(head -n 1 "$pairing_nonce_file" 2>/dev/null || true)"
    case "$nonce" in
      *[!ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789._~-]*|'') ;;
      *)
        printf '%s\n' "$nonce"
        return 0
        ;;
    esac
  fi

  nonce_dir="${pairing_nonce_file%/*}"
  [ "$nonce_dir" = "$pairing_nonce_file" ] || mkdir -p "$nonce_dir" 2>/dev/null || true

  raw="$(od -An -N8 -tx1 /dev/urandom 2>/dev/null | tr -d ' \n' || true)"
  if [ -n "$raw" ]; then
    nonce="$raw"
  else
    seed="$device_id $(cat /proc/sys/kernel/random/boot_id 2>/dev/null) $(cat /sys/class/net/*/address 2>/dev/null)"
    nonce="$(printf '%s' "$seed" | cksum | awk '{print $1}')"
  fi

  if [ ! -d "$pairing_nonce_file" ]; then
    { printf '%s\n' "$nonce" > "$pairing_nonce_file"; } 2>/dev/null || true
  fi
  printf '%s\n' "$nonce"
}

first_ipv4() {
  command -v ip >/dev/null 2>&1 || return 0
  ip -o -4 addr show scope global 2>/dev/null | awk 'NR == 1 { split($4, a, "/"); print a[1]; exit }'
}

stage_pairing_screen() {
  mkdir -p "$screen_run_dir/vendor" 2>/dev/null || return 1

  if [ -r "$screen_source_dir/pairing.html" ]; then
    cp -f "$screen_source_dir/pairing.html" "$screen_run_dir/pairing.html" 2>/dev/null || return 1
  else
    return 1
  fi

  if [ -d "$screen_source_dir/vendor" ]; then
    cp -f "$screen_source_dir"/vendor/* "$screen_run_dir/vendor/" 2>/dev/null || true
  fi
}

write_pairing_json() {
  local tmp_json ip network_status server_label token_label status_text

  tmp_json="$screen_run_dir/pairing.json.$$"
  ip="$(first_ipv4)"
  if [ -n "$ip" ]; then
    network_status="Online"
  else
    network_status="Waiting for network"
  fi
  server_label="${server_base_url:-${assignment_url:-Not configured}}"
  if [ -n "${TALARIA_DEVICE_TOKEN:-}" ]; then
    token_label="configured"
  else
    token_label=""
  fi
  case "$assignment_status" in
    ok) status_text="Ready for assignment" ;;
    failed) status_text="Control plane unavailable; retrying" ;;
    *) status_text="Waiting for assignment" ;;
  esac

  cat > "$tmp_json" <<EOF
{
  "title": "Pair this display",
  "code": "$(json_escape "$pairing_code")",
  "subtitle": "Scan with the Talaria app, or enter this code in Talaria Workbench.",
  "status": "$(json_escape "$status_text")",
  "expiresLabel": "Code refreshes in",
  "expiresAt": "",
  "qrCaption": "Point the Talaria app at this code to claim the display.",
  "qrScheme": "talaria://display/pair",
  "nonce": "$(json_escape "$pairing_nonce")",
  "deviceId": "$(json_escape "$device_id")",
  "network": "$(json_escape "$network_status")",
  "ip": "$(json_escape "$ip")",
  "hardwareTier": "",
  "displayMode": "Pairing",
  "server": "$(json_escape "$server_label")",
  "poll": "$(json_escape "$refresh_seconds")s",
  "lastCheck": "Just now",
  "assignmentSource": "$(json_escape "$assignment_source")",
  "deviceToken": "$(json_escape "$token_label")",
  "version": "Talaria Display OS",
  "build": "$(json_escape "${TALARIA_IMAGE_BUILD:-}")"
}
EOF

  mv -f "$tmp_json" "$screen_run_dir/pairing.json" 2>/dev/null || {
    rm -f "$tmp_json"
    return 1
  }
}

pairing_code="$(make_pairing_code)"
pairing_nonce="$(make_nonce)"
assignment_source="${TALARIA_ASSIGNMENT_SOURCE:-local}"

if stage_pairing_screen && write_pairing_json; then
  # The sibling JSON enables in-place updates. The query string gives
  # WebKit enough fields to render immediately even if local file fetches
  # are restricted by the backend.
  printf 'file://%s?code=%s&deviceId=%s&server=%s&poll=%s&assignmentSource=%s\n' \
    "$screen_run_dir/pairing.html" \
    "$(query_escape "$pairing_code")" \
    "$(query_escape "$device_id")" \
    "$(query_escape "${server_base_url:-${assignment_url:-Not configured}}")" \
    "$(query_escape "${refresh_seconds}s")" \
    "$(query_escape "$assignment_source")"
  exit 0
fi

# Last-ditch fallback if /run is unavailable: show the static shipped page.
printf '%s\n' "file:///usr/share/talaria/screens/pairing.html"
