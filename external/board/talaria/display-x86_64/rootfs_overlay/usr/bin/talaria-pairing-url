#!/bin/sh

pairing_code_file="${TALARIA_PAIRING_CODE_FILE:-/data/talaria/pairing-code}"
device_id="${TALARIA_DEVICE_ID:-unconfigured}"
server_base_url="${TALARIA_SERVER_BASE_URL:-}"
assignment_url="${TALARIA_ASSIGNMENT_URL:-}"
assignment_status="${TALARIA_ASSIGNMENT_FETCH_STATUS:-disabled}"
refresh_seconds="${TALARIA_ASSIGNMENT_REFRESH_SECONDS:-15}"

html_escape() {
  printf '%s' "$1" | sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g; s/"/\&quot;/g'
}

make_pairing_code() {
  local code raw seed code_dir

  if [ -n "${TALARIA_PAIRING_CODE:-}" ]; then
    printf '%s\n' "$TALARIA_PAIRING_CODE"
    return 0
  fi

  if [ -r "$pairing_code_file" ]; then
    code="$(head -n 1 "$pairing_code_file" 2>/dev/null || true)"
    case "$code" in
      [A-Z0-9][A-Z0-9][A-Z0-9][A-Z0-9]-[A-Z0-9][A-Z0-9][A-Z0-9][A-Z0-9])
        printf '%s\n' "$code"
        return 0
        ;;
    esac
  fi

  raw="$(od -An -N4 -tu4 /dev/urandom 2>/dev/null | tr -d ' ' || true)"
  if [ -z "$raw" ]; then
    seed="$device_id $(cat /proc/sys/kernel/random/boot_id 2>/dev/null) $(cat /sys/class/net/*/address 2>/dev/null) $(date +%s 2>/dev/null)"
    raw="$(printf '%s' "$seed" | cksum | awk '{print $1}')"
  fi

  code="$(awk -v n="$raw" 'BEGIN { printf "%08d", n % 100000000 }')"
  code="${code%????}-${code#????}"

  code_dir="${pairing_code_file%/*}"
  [ "$code_dir" = "$pairing_code_file" ] || mkdir -p "$code_dir" 2>/dev/null || true
  printf '%s\n' "$code" > "$pairing_code_file" 2>/dev/null || true
  printf '%s\n' "$code"
}

pairing_code="$(make_pairing_code)"
device_label="$(html_escape "$device_id")"
pairing_label="$(html_escape "$pairing_code")"
server_label="$(html_escape "${server_base_url:-${assignment_url:-Not configured}}")"
status_label="$(html_escape "$assignment_status")"
refresh_label="$(html_escape "$refresh_seconds")"

tmp_file="${TMPDIR:-/tmp}/talaria-pairing-page.$$"
trap 'rm -f "$tmp_file"' EXIT INT TERM

cat > "$tmp_file" <<EOF
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta http-equiv="refresh" content="60">
  <title>Talaria Pairing</title>
  <style>
    :root {
      color-scheme: dark;
      --bg: #071211;
      --panel: #0f1827;
      --ink: #f8fafc;
      --muted: #a8b3c7;
      --teal: #0f766e;
      --cyan: #38bdf8;
      --gold: #facc15;
      --line: rgba(248, 250, 252, 0.16);
    }
    * { box-sizing: border-box; }
    html, body { height: 100%; margin: 0; }
    body {
      align-items: center;
      background:
        linear-gradient(180deg, rgba(15, 118, 110, 0.55), rgba(7, 18, 17, 0.92)),
        var(--bg);
      color: var(--ink);
      display: flex;
      font-family: Arial, Helvetica, sans-serif;
      justify-content: center;
      overflow: hidden;
    }
    main {
      display: grid;
      gap: 32px;
      max-width: 1180px;
      padding: 56px;
      width: 88vw;
    }
    .brand {
      align-items: center;
      display: flex;
      gap: 22px;
    }
    .mark {
      background: var(--gold);
      height: 18px;
      width: 96px;
    }
    .name {
      font-size: 54px;
      font-weight: 800;
      line-height: 1;
    }
    .panel {
      background: var(--panel);
      border: 12px solid var(--gold);
      display: grid;
      gap: 34px;
      grid-template-columns: minmax(0, 1.2fr) minmax(310px, 0.8fr);
      padding: 52px;
    }
    .eyebrow {
      color: var(--cyan);
      font-size: 22px;
      font-weight: 700;
      margin: 0 0 14px;
      text-transform: uppercase;
    }
    h1 {
      font-size: 64px;
      line-height: 1;
      margin: 0 0 24px;
    }
    p {
      color: var(--muted);
      font-size: 27px;
      line-height: 1.32;
      margin: 0;
    }
    .code {
      color: var(--ink);
      font-size: 76px;
      font-weight: 800;
      line-height: 1;
      margin-top: 28px;
      white-space: nowrap;
    }
    .meta {
      border-left: 1px solid var(--line);
      display: grid;
      gap: 22px;
      padding-left: 34px;
    }
    .row {
      display: grid;
      gap: 7px;
    }
    .label {
      color: var(--muted);
      font-size: 18px;
      text-transform: uppercase;
    }
    .value {
      color: var(--ink);
      font-size: 24px;
      overflow-wrap: anywhere;
    }
    .pulse {
      align-items: center;
      display: flex;
      gap: 14px;
      margin-top: 8px;
    }
    .dot {
      animation: pulse 1.4s ease-in-out infinite;
      background: var(--cyan);
      height: 16px;
      width: 16px;
    }
    .bar {
      background: rgba(56, 189, 248, 0.16);
      height: 10px;
      overflow: hidden;
      position: relative;
      width: 240px;
    }
    .bar::after {
      animation: scan 2.8s linear infinite;
      background: var(--cyan);
      content: "";
      height: 100%;
      left: -80px;
      position: absolute;
      top: 0;
      width: 80px;
    }
    @keyframes pulse {
      0%, 100% { opacity: 0.35; transform: scale(0.85); }
      50% { opacity: 1; transform: scale(1); }
    }
    @keyframes scan {
      from { transform: translateX(0); }
      to { transform: translateX(320px); }
    }
    @media (max-width: 860px) {
      main { padding: 28px; width: 100vw; }
      .panel { grid-template-columns: 1fr; padding: 34px; }
      .meta { border-left: 0; border-top: 1px solid var(--line); padding-left: 0; padding-top: 28px; }
      h1 { font-size: 44px; }
      p { font-size: 22px; }
      .code { font-size: 52px; }
      .name { font-size: 38px; }
    }
  </style>
</head>
<body>
  <main>
    <div class="brand">
      <div class="mark"></div>
      <div class="name">TALARIA</div>
    </div>
    <section class="panel" aria-label="Display pairing">
      <div>
        <p class="eyebrow">Ready to pair</p>
        <h1>Connect this display in Workbench</h1>
        <p>Enter this code from the tenant Workbench display setup screen.</p>
        <div class="code">$pairing_label</div>
        <div class="pulse">
          <div class="dot"></div>
          <div class="bar"></div>
        </div>
      </div>
      <div class="meta">
        <div class="row">
          <div class="label">Device ID</div>
          <div class="value">$device_label</div>
        </div>
        <div class="row">
          <div class="label">Control Plane</div>
          <div class="value">$server_label</div>
        </div>
        <div class="row">
          <div class="label">Assignment</div>
          <div class="value">$status_label</div>
        </div>
        <div class="row">
          <div class="label">Refresh</div>
          <div class="value">${refresh_label}s</div>
        </div>
      </div>
    </section>
  </main>
</body>
</html>
EOF

if ! command -v base64 >/dev/null 2>&1; then
  printf '%s\n' "file:///usr/share/talaria/pairing.html"
  exit 0
fi

printf 'data:text/html;base64,'
base64 < "$tmp_file" | tr -d '\n'
printf '\n'
