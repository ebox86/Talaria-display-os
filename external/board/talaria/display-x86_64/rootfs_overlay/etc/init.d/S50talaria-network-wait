#!/bin/sh

log=/data/talaria/network-wait.log
network_iface="${TALARIA_NETWORK_IFACE:-}"

detect_network_iface() {
  if [ -n "$network_iface" ] && [ -d "/sys/class/net/$network_iface" ]; then
    echo "$network_iface"
    return 0
  fi

  for iface_path in /sys/class/net/*; do
    iface="${iface_path##*/}"
    [ "$iface" = "lo" ] && continue
    [ -d "$iface_path" ] || continue
    echo "$iface"
    return 0
  done

  return 1
}

try_dhcp_once() {
  iface="$(detect_network_iface 2>/dev/null || true)"
  [ -n "$iface" ] || return 0

  pidfile="/var/run/udhcpc.$iface.pid"
  if [ -s "$pidfile" ] && kill -0 "$(cat "$pidfile")" 2>/dev/null; then
    return 0
  fi

  echo "Trying DHCP on $iface." >> "$log"
  ip link set "$iface" up >> "$log" 2>&1 || true
  udhcpc -i "$iface" -p "$pidfile" -b -t 3 -T 3 >> "$log" 2>&1 || true
}

ensure_resolv_conf() {
  if grep -q '^nameserver ' /etc/resolv.conf 2>/dev/null; then
    return 0
  fi

  gateway="$(ip route show default 2>/dev/null | awk '/^default / { print $3; exit }')"
  [ -n "$gateway" ] || return 0

  echo "No DNS server in /etc/resolv.conf; using default gateway $gateway." >> "$log"
  {
    echo "# Generated by S50talaria-network-wait fallback."
    echo "nameserver $gateway"
  } > /etc/resolv.conf 2>> "$log" || true
}

case "$1" in
  start)
    mkdir -p /data/talaria
    echo "Waiting for wired network at $(date)" > "$log"
    /usr/bin/talaria-splash network "Waiting for wired network" || true

    i=0
    while [ "$i" -lt 30 ]; do
      if [ "$i" -eq 0 ] || [ "$i" -eq 10 ] || [ "$i" -eq 20 ]; then
        try_dhcp_once
      fi
      if ip route show default 2>/dev/null | grep -q '^default '; then
        ensure_resolv_conf
        echo "Default route detected after ${i}s." >> "$log"
        ip addr show >> "$log" 2>&1 || true
        ip route show >> "$log" 2>&1 || true
        /usr/bin/talaria-splash network "Network ready after ${i}s" || true
        exit 0
      fi
      sleep 1
      i=$((i + 1))
    done

    echo "No default route after 30s; continuing for diagnostics." >> "$log"
    ip addr show >> "$log" 2>&1 || true
    ip route show >> "$log" 2>&1 || true
    /usr/bin/talaria-splash network "No default route yet; diagnostics continue" || true
    ;;
  stop)
    ;;
  restart|reload)
    "$0" start
    ;;
  *)
    echo "Usage: $0 {start|stop|restart|reload}"
    exit 1
    ;;
esac

exit 0
