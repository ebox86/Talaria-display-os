#!/bin/sh
#
# Resolve the effective display mode (dashboard/signage/pairing/diagnostics) and
# keep re-resolving on an interval so an operator can drop a corrected
# /data/talaria/display.conf and recover without a reboot. See
# docs/display-runtime-design.md.

resolve_interval="${TALARIA_MODE_RESOLVE_INTERVAL:-15}"
mode_state="${TALARIA_MODE_STATE:-/run/talaria/mode-state.conf}"
pidfile=/var/run/talaria-mode-resolve.pid

normalize_sleep_seconds() {
  candidate="$1"
  case "$candidate" in
    ''|*[!0-9]*) echo "$resolve_interval" ;;
    *)
      if [ "$candidate" -lt 5 ]; then
        echo 5
      elif [ "$candidate" -gt 3600 ]; then
        echo 3600
      else
        echo "$candidate"
      fi
      ;;
  esac
}

resolve_loop() {
  while true; do
    sleep_seconds="$resolve_interval"
    if [ -f "$mode_state" ]; then
      ASSIGNMENT_REFRESH_SECONDS=
      . "$mode_state"
      case "$ASSIGNMENT_REFRESH_SECONDS" in
        ''|*[!0-9]*) ;;
        *) sleep_seconds="$(normalize_sleep_seconds "$ASSIGNMENT_REFRESH_SECONDS")" ;;
      esac
    fi
    sleep "$sleep_seconds"
    /usr/bin/talaria-resolve-mode
  done
}

case "$1" in
  start)
    mkdir -p /data/talaria
    /usr/bin/talaria-resolve-mode
    resolve_loop &
    echo $! > "$pidfile"
    ;;
  stop)
    if [ -f "$pidfile" ]; then
      kill "$(cat "$pidfile")" 2>/dev/null || true
      rm -f "$pidfile"
    fi
    ;;
  restart|reload)
    "$0" stop
    "$0" start
    ;;
  *)
    echo "Usage: $0 {start|stop|restart|reload}"
    exit 1
    ;;
esac

exit 0
