# Kernel config fragment: broad video driver coverage for the wide
# range of ~2004-2014 x86_64 workstation/desktop hardware this image
# targets, plus a generic fallback for anything without a specific
# driver at all.
#
# BEST-EFFORT: these Kconfig symbol names are not verified against the
# pinned kernel (6.12.94) on real hardware. scripts/verify-browser-packages.sh
# checks that they actually landed in the built kernel's .config; if a
# name is wrong here, that check fails fast rather than silently
# shipping an image with no working display driver on some machines.
#
# Coverage intent, not a promise: every specific chipset this fleet
# might turn up is not going to have a listed driver. CONFIG_DRM_SIMPLEDRM
# plus CONFIG_FB_VESA is the actual safety net — it turns whatever video
# mode GRUB left the hardware in (see grub-bios.cfg's `vga=` boot
# parameter) into a usable DRM device even with zero chipset-specific
# driver support, which matters more here than getting every discrete
# GPU driver exactly right.

CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FB_VESA=y
CONFIG_DRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_SIMPLEDRM=y

# Common discrete/integrated GPUs actually likely to turn up in
# 2004-2014-era office/shop-floor PCs.
CONFIG_DRM_I915=m
CONFIG_DRM_RADEON=m
CONFIG_DRM_NOUVEAU=m

# Server/workstation-board onboard video (Matrox, ASPEED BMC) shows up
# more often than expected in decommissioned corporate hardware.
CONFIG_DRM_MGAG200=m
CONFIG_DRM_AST=m

# QEMU's emulated video adapters, so the QEMU smoke test can eventually
# exercise the real DRM/Cog path instead of only the console splash.
CONFIG_DRM_BOCHS=y
CONFIG_DRM_CIRRUS_QEMU=y
