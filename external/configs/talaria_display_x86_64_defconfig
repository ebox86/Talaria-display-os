# --- Browser stack (Phase 3): WPE WebKit + Cage + Cog ---
#
# Symbol names below are now verified against the actual Buildroot
# 2026.05.1 source (downloaded and read package/{wpewebkit,cog,mesa3d}
# /Config.in directly - not guessed, not summarized secondhand).
# scripts/verify-browser-packages.sh's fast-fail check only confirms
# these symbols *resolved*, not that the full build or VM/runtime path
# succeeds.
#
# History, for whoever hits this again: iteration 1 (first real CI
# run, PR #4) failed with WPEWEBKIT/COG/COG_PLATFORM_DRM all missing.
# Root-caused by downloading the real Buildroot source and reading the
# actual Config.in files instead of continuing to guess:
#   - wpewebkit needs BR2_PACKAGE_HAS_LIBGLES, provided by
#     `select BR2_PACKAGE_HAS_LIBGLES` on BR2_PACKAGE_MESA3D_OPENGL_ES.
#     The defconfig had BR2_PACKAGE_MESA3D_OPENGL_ES2, which doesn't
#     exist in this Buildroot version (no ES1/ES2 split - just one
#     "OpenGL ES" option) - silently dropped, so HAS_LIBGLES was never
#     provided, so wpewebkit's `depends on BR2_PACKAGE_HAS_LIBGLES`
#     failed, cascading to cog (`depends on BR2_PACKAGE_WPEWEBKIT`).
#   - wpewebkit's Config.in already has `select BR2_PACKAGE_WAYLAND`
#     and `select BR2_PACKAGE_WAYLAND_PROTOCOLS` itself once enabled.
#     The first working browser image launched Cog's DRM backend
#     directly. Real-site VM testing then exposed repeated
#     libcogplatform-drm.so crashes after redirects/repaints, so the
#     runtime default is now Cage as a single-app Wayland compositor
#     running Cog's Wayland platform. Direct Cog DRM stays built as a
#     fallback/debug backend.
#   - GCC version was not the issue: this Buildroot's default internal
#     toolchain is gcc 14.x for x86_64, well above wpewebkit's gcc >=11
#     requirement.
#
# Iteration 2 (second real CI run) got past package resolution and
# failed differently: "Makefile.legacy: You have legacy configuration
# in your .config!". Cross-referenced every symbol in this file against
# Buildroot's actual top-level Config.in.legacy (also downloaded, not
# guessed) and found one match: BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_SWRAST
# was renamed to BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_SOFTPIPE in this
# Buildroot version. The old name is kept as a real (deprecated)
# Kconfig option that auto-selects the new one via `select`, so it
# still resolved to 'y' and passed verify-browser-packages.sh's check -
# but setting BR2_LEGACY that way hard-stops any real build target
# (make linux-configure, the full build, etc.), just not the initial
# defconfig merge itself. Fixed by setting the current name directly.
#
# Tier 2 graphics support: keep software rendering fallbacks, plus add
# broad x86 Mesa user-space coverage for common Intel, Radeon/AMD,
# Nouveau, VMware, and QEMU/virtio paths. The kernel fragment already
# carries the matching DRM modules where Linux has maintained support.
# LLVM makes this heavier, but it is required for modern Intel Iris,
# RadeonSI, and llvmpipe.
BR2_PACKAGE_LIBDRM=y
BR2_PACKAGE_MESA3D=y
BR2_PACKAGE_MESA3D_LLVM=y
BR2_PACKAGE_MESA3D_OPENGL_EGL=y
BR2_PACKAGE_MESA3D_OPENGL_ES=y
BR2_PACKAGE_MESA3D_GBM=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_CROCUS=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_I915=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_IRIS=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_LLVMPIPE=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_NOUVEAU=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_R300=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_R600=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_RADEONSI=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_SOFTPIPE=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_SVGA=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_VIRGL=y
BR2_PACKAGE_WPEWEBKIT=y
BR2_PACKAGE_WPEBACKEND_FDO=y
BR2_PACKAGE_CAIRO=y
BR2_PACKAGE_CAIRO_PNG=y
BR2_PACKAGE_CAGE=y
BR2_PACKAGE_COG=y
# Direct Cog DRM rendered the local browser test page, but VM testing
# against neverssl.com repeatedly crashed in libcogplatform-drm.so after
# redirects/repaints. Keep DRM built as a fallback/debug backend, but
# ship the deliberate runtime path as Cage + Cog's Wayland backend.
BR2_PACKAGE_COG_PLATFORM_FDO=y
BR2_PACKAGE_COG_PLATFORM_DRM=y

# Runtime data Cog/WPE do not fully pull in themselves:
# - WPEWebKit selects fontconfig/freetype, but those are libraries, not
#   actual font files. Without installed fonts, a successfully launched
#   browser can still render missing/blank text. DejaVu gives broad
#   fallback coverage; Liberation gives common Arial/Times/Courier-like
#   faces that web dashboards often request.
# - Cog/libWPE select libxkbcommon, but not the XKB keymap database.
#   Without xkeyboard-config, libxkbcommon logs:
#     failed to add default include path /usr/share/X11/xkb
#   The package lives under Buildroot's x11r7 tree for historical
#   reasons, but enabling it here does not enable Xorg.
BR2_PACKAGE_DEJAVU=y
BR2_PACKAGE_LIBERATION=y
BR2_PACKAGE_XKEYBOARD_CONFIG=y
