menu "Talaria Display OS"

source "$BR2_EXTERNAL_TALARIA_DISPLAY_OS_PATH/package/plymouth/Config.in"

config BR2_PACKAGE_TALARIA_DISPLAY_OS_NOTES
	bool "Talaria display OS project notes"
	help
	  This external tree currently provides board files, rootfs overlays,
	  and scripts for the Talaria Display OS proof of concept. The image
	  boots to local diagnostics by default and can supervise a kiosk
	  browser for dashboard and signage modes once assigned.

endmenu
